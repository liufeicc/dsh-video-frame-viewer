{
  "name": "@local/dsh-video-frame-viewer",
  "version": "1.0.0",
  "private": true,
  "description": "在左侧工具栏逐帧查看本地 MP4：正常播放、慢放快放、前后单帧、单击缩略帧跳转",
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "client.mp4.js",
    "client.playback.js",
    "client.icons.js",
    "client.view.js",
    "client.window.js",
    "client.strip.js",
    "client.styles.js",
    "client.dicts.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
